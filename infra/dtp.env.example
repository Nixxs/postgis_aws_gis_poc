# DTP non-production deployment. Copy to infra/dtp.env (ignored by Git).
AWS_PROFILE=dtp-admin
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=376640768813

# Existing DTP private network.
VPC_ID=vpc-023e72281583163b1
SUBNET_IDS=subnet-07cc9aa75b212f232,subnet-0bf0c3d4918d95227
TASK_SECURITY_GROUP_ID=
DB_SECURITY_GROUP_ID=
ASSIGN_PUBLIC_IP=DISABLED
PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::376640768813:policy/Accelerator-Permission-Boundary-Policy

# Platform-provisioned roles. Setting these makes the deployers skip IAM changes.
API_EXECUTION_ROLE_ARN=arn:aws:iam::376640768813:role/gis-postgis-api-execution-role
API_TASK_ROLE_ARN=arn:aws:iam::376640768813:role/gis-postgis-api-task-role
TILECACHE_EXECUTION_ROLE_ARN=arn:aws:iam::376640768813:role/gis-postgis-tilecache-execution-role
TILECACHE_JOB_ROLE_ARN=arn:aws:iam::376640768813:role/gis-postgis-tilecache-job-role

# Permanent private source-data bucket. Disposable importer compute is removed after each run.
IMPORT_BUCKET=gis-postgis-source-376640768813

# RDS provisioned by infra/provision-rds.ps1.
RDS_INSTANCE_ID=gis-postgis-poc
RDS_SUBNET_GROUP=gis-postgis-poc
RDS_SECURITY_GROUP_NAME=gis-postgis-rds-sg
RDS_INSTANCE_CLASS=db.t4g.medium
RDS_ALLOCATED_STORAGE=100
RDS_ENGINE_VERSION=
RDS_BACKUP_RETENTION_DAYS=7
DB_USER=gisadmin
DB_PASSWORD=REPLACE_AFTER_RDS_PROVISION
DB_HOST=REPLACE_AFTER_RDS_PROVISION
DB_PORT=5432
DB_NAME=gis

# API deployment.
ECR_REPOSITORY=gis-postgis-api
ECS_CLUSTER=gis-postgis-cluster
ECS_SERVICE=gis-postgis-api
TASK_FAMILY=gis-postgis-api
SECRET_NAME=gis-postgis-api-config
ALB_NAME=gis-postgis-api-alb
TARGET_GROUP_NAME=gis-postgis-api-tg
HTTP_API_NAME=gis-postgis-api
# The DTP orchestrator replaces these after CloudFront is created.
FRONTEND_URL=https://placeholder.invalid
FRONTEND_OL_URL=
FRONTEND_API_URL=https://placeholder.invalid
FRONTEND_OL_API_URL=https://placeholder.invalid

# MapLibre frontend (separate from OpenLayers).
FRONTEND_BUCKET=gis-postgis-frontend-376640768813
FRONTEND_CLOUDFRONT_COMMENT=gis-postgis-frontend
FRONTEND_OAC_NAME=gis-postgis-frontend-oac

# OpenLayers frontend.
FRONTEND_OL_BUCKET=gis-postgis-frontend-ol-376640768813
FRONTEND_OL_CLOUDFRONT_COMMENT=gis-postgis-frontend-ol
FRONTEND_OL_OAC_NAME=gis-postgis-frontend-ol-oac

# Tile cache and CDN.
TILECACHE_ECR_REPOSITORY=gis-postgis-tilecache
TILECACHE_BUCKET=gis-postgis-tilecache-376640768813
TILECACHE_PREFIX=tiles
TILECACHE_COMPUTE_ENV=gis-postgis-tilecache-fargate
TILECACHE_JOB_QUEUE=gis-postgis-tilecache
TILECACHE_JOB_DEFINITION=gis-postgis-tilecache
TILECACHE_MAX_VCPUS=16
TILECACHE_JOB_VCPUS=2
TILECACHE_JOB_MEMORY=4096
TILECACHE_JOB_TIMEOUT=86400
TILECACHE_CLOUDFRONT_COMMENT=gis-postgis-tilecache
TILECACHE_OAC_NAME=gis-postgis-tilecache-oac
TILECACHE_RESPONSE_HEADERS_POLICY=gis-postgis-tilecache-cors
# Filled automatically after the CDN deployment; overrides config.json at build time.
TILECACHE_CDN_URL=https://placeholder.invalid
