# AWS
AWS_PROFILE=intelligis.io
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=878564871075

# Existing private network
VPC_ID=vpc-080f02afd00a7d9f6
SUBNET_IDS=subnet-0629c8eb8de136659,subnet-088424f3b8ff0e18e
TASK_SECURITY_GROUP_ID=
# Optional: when set, the script allows TASK_SECURITY_GROUP_ID to reach PostgreSQL.
DB_SECURITY_GROUP_ID=sg-0eba9036c61f47fbb
ASSIGN_PUBLIC_IP=ENABLED
# Optional; required only in accounts that enforce an IAM permissions boundary.
PERMISSIONS_BOUNDARY_ARN=

# Deployment names
ECR_REPOSITORY=gis-postgis-api
ECS_CLUSTER=gis-postgis-cluster
ECS_SERVICE=gis-postgis-api
TASK_FAMILY=gis-postgis-api
SECRET_NAME=gis-postgis-api-config
ALB_NAME=gis-postgis-api-alb
TARGET_GROUP_NAME=gis-postgis-api-tg
HTTP_API_NAME=gis-postgis-api

# On-demand PostGIS -> S3 MVT pyramid (infra/deploy-tilecache.ps1).
# Blank values are not allowed for these settings when explicitly provided;
# omit them to use the defaults documented in tilecache/README.md.
TILECACHE_ECR_REPOSITORY=gis-postgis-tilecache
TILECACHE_BUCKET=gis-postgis-tilecache-878564871075
TILECACHE_PREFIX=tiles
TILECACHE_COMPUTE_ENV=gis-postgis-tilecache-fargate
TILECACHE_JOB_QUEUE=gis-postgis-tilecache
TILECACHE_JOB_DEFINITION=gis-postgis-tilecache
TILECACHE_MAX_VCPUS=16
TILECACHE_JOB_VCPUS=2
TILECACHE_JOB_MEMORY=4096
TILECACHE_JOB_TIMEOUT=86400
# Dedicated private-S3 CloudFront CDN (infra/deploy-tilecache-cdn.ps1).
TILECACHE_CLOUDFRONT_COMMENT=gis-postgis-tilecache
TILECACHE_OAC_NAME=gis-postgis-tilecache-oac
TILECACHE_RESPONSE_HEADERS_POLICY=gis-postgis-tilecache-cors

# Static frontend deployment (optional; defaults include AWS_ACCOUNT_ID)
FRONTEND_BUCKET=gis-postgis-frontend-878564871075
FRONTEND_CLOUDFRONT_COMMENT=gis-postgis-frontend
FRONTEND_OAC_NAME=gis-postgis-frontend-oac

# Independent OpenLayers UI: infra/deploy-frontend-ol.ps1 builds frontend-ol only.
# These names must differ from the original frontend. Blank values use OL defaults.
# Default bucket: gis-postgis-frontend-ol-<verified AWS account ID>.
# The script never delegates to the original deployer or installs UI dependencies.
# Read from this file only (inherited FRONTEND / FRONTEND_OL settings are not reused).
FRONTEND_OL_BUCKET=
FRONTEND_OL_CLOUDFRONT_COMMENT=gis-postgis-frontend-ol
FRONTEND_OL_OAC_NAME=gis-postgis-frontend-ol-oac
# Shared existing API, NOT the original frontend URL. Public build-time value;
# never put credentials in Vite settings. Sets both query and tile API URLs.
FRONTEND_OL_API_URL=https://REPLACE_WITH_SHARED_API_HOST
# The OL build always uses VITE_CONFIG_URL=/config.json from its own public/ directory.

# Database and CORS configuration stored in AWS Secrets Manager by deploy-api.ps1
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
DB_HOST=REPLACE_WITH_DATABASE_HOST
DB_PORT=5432
DB_NAME=gis
FRONTEND_URL=https://REPLACE_WITH_FRONTEND_HOST
# Optional second CORS origin (scheme + host, no trailing slash or path).
# Leave blank to preserve single-frontend access; retain FRONTEND_URL above.
# After deploying OL, set this to its https://<distribution>.cloudfront.net origin.
FRONTEND_OL_URL=
